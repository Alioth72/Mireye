# Dashboard API token from www.mireye.com account settings (JWT, 90-day default).
# NOTE: MCP OAuth tokens are NOT accepted on /v1/* -- different credential path.
MIREYE_API_TOKEN=
MIREYE_BASE_URL=https://api.mireye.com

PHASE2_DATABASE_URL=sqlite:///./phase2.db
PHASE3_DATABASE_URL=sqlite:///./phase3.db

# Phase 1 LLM extraction. Either key alone is enough (monitor_records/extract.py falls
# back to the keyword heuristic if neither is set or the call fails). If both are set,
# LLM_PROVIDER picks which is primary ("openai" | "gemini") -- the other is used
# automatically as a fallback if the primary's call fails (e.g. a rate limit).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
LLM_PROVIDER=openai
